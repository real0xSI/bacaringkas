# Salin ke .env dan isi dari Firebase console > Project settings > Your apps > Web app.
# JANGAN commit .env. JANGAN taruh API key / secret apa pun di repo publik
# selain web config ini (itu config publik Firebase, bukan secret server).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check reCAPTCHA Enterprise site key (dibuat di Firebase console > App Check).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# App Check debug token (dipakai kalau tidak ada site key reCAPTCHA; daftarkan
# token ini sekali di Firebase console > App Check > Manage debug tokens).
VITE_APPCHECK_DEBUG_TOKEN=
